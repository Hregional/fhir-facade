# Archivos de compose a cargar.
# Produccion: descomentar para NO cargar docker-compose.override.yml (solo desarrollo).
# Desarrollo: dejar comentado.
#COMPOSE_FILE=docker-compose.yml

# Configuración de la Interfaz Web (UI)
SHOW_UI=true
FHIR_BASE_URL=http://localhost:8080/fhir/

# URL publica del servidor (por donde lo consumen los clientes, p. ej. via OpenHIM).
# Se usa en fullUrl, link y Location. Vacia = usa el Host de cada peticion.
FHIR_SERVER_ADDRESS=https://openhim-qa-router.hro.gob.gt/fhir

# URL Base de la API Legacy del HRO
# En el servidor, este contenedor se comunica con el contenedor `api-pacientes`
# por la red Docker externa `hro-net`. Usar el nombre del contenedor y su puerto
# INTERNO (no el publicado en el host):
#   API_URL=http://api-pacientes:8080
API_URL=https://api-legacy.hro.gob.gt
# Puerto docker
DOCKER_PORT=8082

# Opciones de Maven para el build de la imagen. Dejar vacio si no hay proxy.
# En servidores que salen a internet via proxy HTTP (p. ej. Squid), usar:
#   MAVEN_OPTS="-Dhttp.proxyHost=IP -Dhttp.proxyPort=3128 -Dhttps.proxyHost=IP -Dhttps.proxyPort=3128"
MAVEN_OPTS=

# Memoria del contenedor y de la JVM.
# Deja ~250MB entre -Xmx y MEM_LIMIT para memoria fuera del heap.
# Produccion: MEM_LIMIT=768m / -Xmx512m. Desarrollo: MEM_LIMIT=1g / -Xmx768m
MEM_LIMIT=768m
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseSerialGC"
# En servidores detras de proxy (SSO solo accesible via proxy), agregar a JAVA_OPTS
# solo el proxy HTTPS. api-pacientes (http://) va directo por hro-net.
# No usar -Dhttp.nonProxyHosts con "|": catalina.sh hace eval de JAVA_OPTS y lo
# interpreta como pipe (el contenedor no arranca).
#   JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseSerialGC -Dhttps.proxyHost=IP -Dhttps.proxyPort=3128"

# Configuración OAuth2 para obtener tokens de acceso
ACCESS_TOKEN_URL=https://auth.hro.gob.gt/realms/hro/protocol/openid-connect/token
CLIENT_ID=fhir-facade-client
CLIENT_SECRET=tu-client-secret-aqui
USERNAME=usuario-api
PASSWORD=password-api
